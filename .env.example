# ============================================
# Environment Configuration File Template
# ============================================
# Copy this file to .env and fill in your actual values
# The .env file is ignored by git to protect sensitive data
# ============================================

# ========== WiFi Configuration ==========
# Your WiFi network name
WIFI_SSID=YourWiFiNetworkName

# Your WiFi password
WIFI_PASSWORD=YourWiFiPassword

# ========== Server Configuration ==========
# Your computer's IP address (find with: ipconfig on Windows, ifconfig on Linux/Mac)
# The ESP32 will send sensor data to this IP
SERVER_IP=192.168.1.100

# Port for the data receiver server
SERVER_PORT=5000

# ========== Motor Speed Levels (PWM 0-255) ==========
# Low speed (33% of max)
MOTOR_SPEED_LOW=85

# Medium speed (67% of max)
MOTOR_SPEED_MEDIUM=170

# High speed (100% of max)
MOTOR_SPEED_HIGH=255

# ========== Obstacle Detection ==========
# Distance threshold in centimeters (car will avoid obstacles closer than this)
OBSTACLE_DISTANCE_CM=30

# Turn duration in milliseconds (how long to turn when avoiding obstacle)
TURN_DURATION_MS=500

# ========== Sensor Reading Intervals ==========
# How often to read sensors (milliseconds)
# 200ms = 5 readings per second
SENSOR_READ_INTERVAL_MS=200

# How often to update TFT display (milliseconds)
# 500ms = 2 updates per second
TFT_UPDATE_INTERVAL_MS=500

# ========== Data Storage Formats ==========
# Choose which formats to save sensor data
# Set to 'true' or 'false' (lowercase)

# JSON/JSONL format (default, recommended)
SAVE_JSON=true

# CSV format (spreadsheet compatible)
SAVE_CSV=false

# SQLite database format
SAVE_SQLITE=false

# Parquet format (efficient, compressed - requires pyarrow)
SAVE_PARQUET=false

# HDF5 format (scientific data - requires h5py)
SAVE_HDF5=false

# Excel format (.xlsx - requires openpyxl)
SAVE_EXCEL=false
